        prompt("Prev. Simulation Mode")
    }
    field(SSCN, DBF_MENU) {
        initial("65535")
        promptgroup("90 - Simulate")
        interest(1)
        menu(menuScan)
        prompt("Sim. Mode Scan")
    }
    field(SDLY, DBF_DOUBLE) {
        initial("-1.0")
