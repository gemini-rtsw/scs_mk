        promptgroup("20 - Scan")
        special(SPC_SCAN)
        interest(1)
        menu(menuScan)
        prompt("Scan Mechanism")
    }
    field(PINI, DBF_MENU) {
        promptgroup("20 - Scan")
        interest(1)
        menu(menuPini)
        prompt("Process at iocInit")
    }
    field(PHAS, DBF_SHORT) {
        promptgroup("20 - Scan")
