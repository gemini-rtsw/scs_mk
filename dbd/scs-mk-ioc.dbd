        interest(1)
        pp(TRUE)
        prompt("Hihi Alarm Limit")
    }
    field(LOLO, DBF_DOUBLE) {
        promptgroup("70 - Alarm")
        prop(YES)
        interest(1)
        pp(TRUE)
